from transformers import GPT2LMHeadModel, GPT2Tokenizer

# Load pre-trained GPT-2 model and tokenizer
model_name = "gpt2"  # You can use "gpt2-medium", "gpt2-large", etc. for bigger models
tokenizer = GPT2Tokenizer.from_pretrained(model_name)
model = GPT2LMHeadModel.from_pretrained(model_name)

# Encode input text and generate output
input_text = "The future of AI is"
input_ids = tokenizer.encode(input_text, return_tensors="pt")

# Generate text (adjust parameters as needed)
output = model.generate(
    input_ids,
    max_length=100,          # Maximum length of generated text
    num_return_sequences=1,  # Number of responses
    temperature=0.7,         # Controls randomness (lower = more deterministic)
    top_k=50,               # Limits sampling to top-k likely next words
    pad_token_id=tokenizer.eos_token_id  # Avoids warning messages
)

# Decode and print the generated text
generated_text = tokenizer.decode(output[0], skip_special_tokens=True)
print(generated_text)



